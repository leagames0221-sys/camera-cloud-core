# Demo values for a local, throw-away run. Copy this file to .env before the first start:
#   copy .env.example .env      (Windows)      cp .env.example .env      (Linux / macOS)
# .env is ignored by git. Change these if the machine is reachable from other computers.

# Database password (the database is not published to the host)
POSTGRES_PASSWORD=demo-postgres-change-me

# Keycloak administrator (http://localhost:8080/admin)
KC_ADMIN_USER=admin
KC_ADMIN_PASSWORD=demo-keycloak-admin-change-me

# One password for the nine demo users in the realm file:
#   partner-admin, a-admin, a-viewer, b-admin, b-viewer, c-admin, c-viewer,
#   and l-admin, l-viewer (used only by the load test)
DEMO_USER_PASSWORD=demo-user-change-me
