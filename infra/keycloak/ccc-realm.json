{
  "realm": "ccc",
  "displayName": "camera-cloud-core",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "rememberMe": false,
  "loginWithEmailAllowed": false,
  "duplicateEmailsAllowed": false,
  "bruteForceProtected": true,
  "accessTokenLifespan": 300,
  "identityProviders": [],
  "identityProviderMappers": [],
  "clients": [
    {
      "clientId": "ccc-web",
      "name": "Viewing page",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:8000/"
      ],
      "webOrigins": [
        "http://localhost:8000"
      ],
      "baseUrl": "http://localhost:8000/",
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:8000/",
        "oauth2.device.authorization.grant.enabled": "false"
      }
    },
    {
      "clientId": "ccc-device",
      "name": "Camera registration (device authorization grant)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "consentRequired": true,
      "fullScopeAllowed": false,
      "defaultClientScopes": [
        "basic"
      ],
      "optionalClientScopes": [],
      "attributes": {
        "oauth2.device.authorization.grant.enabled": "true",
        "oauth2.device.code.lifespan": "600",
        "oauth2.device.polling.interval": "5",
        "use.refresh.tokens": "false",
        "display.on.consent.screen": "true",
        "consent.screen.text": "Register a camera in your tenant (カメラをテナントに登録する)"
      },
      "protocolMappers": [
        {
          "name": "enroll-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "ccc-enroll",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true",
            "lightweight.claim": "false"
          }
        }
      ]
    }
  ],
